# Copy to .env, then edit these values. Never commit real secrets.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash

LIBERTY_DATABASE_URL=postgresql+psycopg://storebridge:CHANGE_ME@localhost:5432/walk_liberty
GALLE_FACE_DATABASE_URL=postgresql+psycopg://storebridge:CHANGE_ME@localhost:5432/walk_ogf
PETTAH_DATABASE_URL=postgresql+psycopg://storebridge:CHANGE_ME@localhost:5432/walk_pettah
AUTH_DATABASE_URL=postgresql+psycopg://storebridge:CHANGE_ME@localhost:5432/storebridge_auth

OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-before-first-seed
JWT_SECRET=replace-with-64-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5173
MAX_DEMO_REQUESTS_PER_HOUR=35

# Optional: tracing is disabled when keys are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
